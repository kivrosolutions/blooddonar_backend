# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="mysql://your_db_user:your_db_password@your_db_host:3306/your_db_name"

# JWT
JWT_SECRET=generate-a-random-32-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=generate-another-random-32-char-string
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000
# Production: CORS_ORIGIN=https://orchid-crow-337204.hostingersite.com

# ImageKit
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id/

# Resend (Email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev
